# Copy to .env.local and fill in real values. Never commit .env.local.
# Reference: docs/online-photobooth-ops-runbook.md §2

# Public — safe in client bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret — server-side only, never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=
SENTRY_DSN=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
