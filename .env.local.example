# Copy to .env.local and fill in real values. Never commit .env.local.
# Reference: docs/online-photobooth-ops-runbook.md §2

# Public — safe in client bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Full origin (e.g. https://stripsnap.app), no trailing slash. Resolves
# relative URLs in page metadata (app/layout.tsx's metadataBase) into
# absolute ones — needed so shared /strip/:id links unfurl with a real
# og:image instead of localhost. Safe to leave unset in local dev.
NEXT_PUBLIC_SITE_URL=

# Secret — server-side only, never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (local dev only; from `supabase status` as DB_URL).
# Only used by supabase/migrations/*.test.ts to exercise RLS policies (e.g. realtime.messages)
# that live outside the PostgREST-exposed tables supabase-js talks to.
SUPABASE_DB_URL=
# Signs the short-lived per-participant Realtime Authorization token minted by /join.
# Found in Supabase project API settings, distinct from the service role key.
SUPABASE_JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SENTRY_DSN=
# Org/project slugs used only by the Sentry build-time plugin (source map
# upload) in next.config.mjs -- withSentryConfig no-ops cleanly when these
# (or SENTRY_DSN above) are unset, so local dev/CI never require a real
# Sentry account. Found in Sentry project settings once an account exists.
SENTRY_ORG=
SENTRY_PROJECT=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# Bearer-token secret authorizing cron-triggered requests (Vercel Cron's
# standard `Authorization: Bearer $CRON_SECRET` convention). Guards
# app/api/cron/daily-metrics and app/api/cron/expire-sessions. Generate a
# random value (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# per environment -- never reuse the same value across dev/preview/production.
CRON_SECRET=
