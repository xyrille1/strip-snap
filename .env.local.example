# Copy to .env.local and fill in real values. Never commit .env.local.
# Reference: docs/online-photobooth-ops-runbook.md §2

# Public — safe in client bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret — server-side only, never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# Signs the short-lived per-participant Realtime Authorization token minted by /join.
# Found in Supabase project API settings, distinct from the service role key.
SUPABASE_JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SENTRY_DSN=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
